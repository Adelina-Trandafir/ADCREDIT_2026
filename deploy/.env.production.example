# =============================================================================
# ADCREDIT3 - Environment variables PRODUCTION
# Copiaza in /opt/adcredit3/.env si completeaza valorile.
# chmod 600 .env  (obligatoriu!)
# =============================================================================

# ---------- Flask ----------
FLASK_APP=app.py
FLASK_ENV=production

# DEBUG: true pastreaza endpoint-ul /debug/logs si logging detaliat
# Pune false daca vrei sa dezactivezi Werkzeug debugger complet
FLASK_DEBUG=true

FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# ---------- Securitate ----------
# Genereaza cu: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=SCHIMBA_CU_UN_SECRET_RANDOM_LUNG

ADMIN_MASTER_KEY=SCHIMBA_CU_UN_KEY_ADMIN_SIGUR
CSRF_ENABLED=true

# Session timeout in minute
SESSION_TIMEOUT=15

# HTTPS_ENABLED=true => cookie SESSION_COOKIE_SECURE=True
HTTPS_ENABLED=false

# ---------- Iframe ----------
# auto = in production foloseste sameorigin automat
ALLOW_IFRAMES=auto

# ---------- Database MySQL (extern) ----------
DB_HOST=89.44.137.153
DB_PORT=3306
DB_NAME=SVN_00
DB_SERVICE_USER=SCHIMBA_SAU_PASTREAZA
DB_SERVICE_PASSWORD=SCHIMBA_PAROLA_DB

# ---------- Redis (local pe server) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=SCHIMBA_PAROLA_REDIS
REDIS_DB=0
REDIS_BLOCK_DURATION=3600

# ---------- Logging ----------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# ---------- reCAPTCHA ----------
RECAPTCHA_SECRET_KEY=SCHIMBA_CU_CHEIA_RECAPTCHA
