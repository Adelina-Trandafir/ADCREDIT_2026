{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: Run & Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--port",
                "5001"
            ],
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "true"
            },
            "envFile": "${workspaceFolder}/.env",
            "jinja": true,
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "serverReadyAction": {
                "action": "debugWithChrome",
                "pattern": "Running on http://[\\w.]+:(\\d+)",
                "uriFormat": "http://localhost:%s"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:5001",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}/.chrome-debug"
        }
    ],
    "compounds": [
        {
            "name": "Flask + Chrome",
            "configurations": [
                "Flask: Run & Debug",
                "Launch Chrome against localhost"
            ],
            "stopAll": true
        }
    ]
}